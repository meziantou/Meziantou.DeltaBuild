<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
    <PackageVersion Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52" />
    <PackageVersion Include="Meziantou.Framework.FullPath" Version="3.0.18" />
    <PackageVersion Include="Meziantou.Framework.Globbing" Version="5.0.11" />
    <PackageVersion Include="System.CommandLine" Version="2.0.14" />
  </ItemGroup>
  <!-- Microsoft.Build 18.10+ only targets net11.0 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageVersion Include="Microsoft.Build" Version="18.9.6" />
    <PackageVersion Include="Microsoft.Build.Framework" Version="18.9.6" />
    <PackageVersion Include="Microsoft.NET.StringTools" Version="18.9.6" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <PackageVersion Include="Microsoft.Build" Version="18.12.2" />
    <PackageVersion Include="Microsoft.Build.Framework" Version="18.12.2" />
    <PackageVersion Include="Microsoft.NET.StringTools" Version="18.12.2" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Meziantou.Framework.InlineSnapshotTesting" Version="6.0.25" />
    <PackageVersion Include="Meziantou.Framework.TemporaryDirectory" Version="3.0.18" />
  </ItemGroup>
</Project>