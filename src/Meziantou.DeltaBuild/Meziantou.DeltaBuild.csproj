<Project Sdk="Meziantou.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Version>1.6.1</Version>
    <SearchReadmeFileAbove>true</SearchReadmeFileAbove>

    <!-- MSBuild evaluates the projects on many threads and allocates a lot. Server GC scales with
         these threads, and tiered PGO instrumentation costs more than it saves in a short-lived process. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.StringTools" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Locator" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
    <PackageReference Include="Microsoft.VisualStudio.SolutionPersistence" />
    <PackageReference Include="Meziantou.Framework.FullPath" />
    <PackageReference Include="Meziantou.Framework.Globbing" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
</Project>
